# Backend API Base URL
NEXT_PUBLIC_API_URL=https://backend-decofleursplus-staging.up.railway.app/api/v1

# Optionnel : si exécution locale avec le backend local sur port 5000
# NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Connexion Google : client ID OAuth « Application Web » (identique à GOOGLE_CLIENT_ID du backend).
# Dans la console Google Cloud, ajouter les origines JavaScript autorisées (ex. http://localhost:3000 et le domaine de production).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optionnel : backend ciblé par le proxy /api/v1 du serveur Next (défaut : backend staging)
# API_PROXY_TARGET=http://localhost:5000
